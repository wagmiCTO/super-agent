# Copy to services/.env and fill in. Never commit the filled-in file.

# testnet (default) | mainnet. Mainnet also requires PERPL_ALLOW_MAINNET=1.
PERPL_NETWORK=testnet

# Create a trade-scoped key at https://testnet.perpl.xyz/apikeys.
# The secret is shown once and cannot be recovered.
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# Optional: pin the exchange account when a wallet has more than one.
# Discovered from the wallet snapshot when unset.
# PERPL_ACCOUNT_ID=

# Our registered Perpl builder code. Issued by Perpl (same id on testnet and
# mainnet). It is bound to an API key at enrollment and frozen there; orders
# never carry it. Verify with: go run ./cmd/perplenroll -check
PERPL_BUILDER_ID=

# The builder fee charged per order, in hundred-thousandths (1 = 0.1 bps,
# ceiling 100 = 0.1%). Only accepted on a key enrolled with PERPL_BUILDER_ID.
# PERPL_BUILDER_FEE_PER_100K=

# Origin header for API-key enrollment. Leave unset for the server-side path
# (accepted without an Origin). A browser cannot omit the header, so the app's
# origin must be whitelisted by Perpl before enrolling from the client.
# PERPL_ENROLL_ORIGIN=

# Mainnet is a loud, explicit choice. Leave this unset.
# PERPL_ALLOW_MAINNET=1

# Keep enrolled user keys across restarts. Plain JSON, 0600 — testnet only.
# PLATFORM_KEYS_FILE=.keys.json
# Log level: info (default) or debug (every trading-socket frame type).
# PLATFORM_LOG=debug

# Weekly prize pool on-chain (testnet). The settler key spends gas and the prize
# budget in the venue's collateral token; never the users' funds.
# PLATFORM_SETTLER_KEY=0x...
# PLATFORM_CHAIN_RPC=https://testnet-rpc.monad.xyz
# PLATFORM_PRIZE_POOL_ADDRESS=0x19952068Ce2D25C672d71cD48775A9f43438f4E6
# Added to a strategy's pool per closed trade, in collateral units (0 disables funding).
# PLATFORM_PRIZE_PER_TRADE=0.1

# Postgres, the system of record. Without it the platform keeps state in memory (development only).
# DATABASE_URL=postgres://tradeagent:tradeagent@localhost:5433/tradeagent?sslmode=disable
# A separate database for `go test` (internal/store); tests skip without it.
# TEST_DATABASE_URL=postgres://tradeagent:tradeagent@localhost:5433/tradeagent_test?sslmode=disable
# Let requests without a wallet header trade the platform's own account.
# For a development box and the browser tests only; never set it where the
# platform is reachable from the internet.
# PLATFORM_OWN_ACCOUNT=1
# Partner integrations: each is on when its key is set.
# NANSEN_API_KEY=            # https://app.nansen.ai/api — the on-chain context card
# NANSEN_TOKENS=MON=monad:0x3bd359c1119da7da1d913d1c4d2b7c461115433a
# NANSEN_CACHE=4h
# AURORA_API_KEY=            # https://portal.intents.aurora.dev — any-chain deposits
# AURORA_DESTINATION_ASSET=  # Aurora asset id delivered to the wallet; USDC on Monad by default
# AURORA_FEE_RECIPIENT=0x... # optional platform fee on deposits
# AURORA_FEE_BPS=0
# ENVIO_GRAPHQL_URL=         # the prize-pool indexer (indexers/prize-pool) — the lobby's past weeks
# A second venue key for a laptop running beside the hosted platform goes in
# .env.local, which overrides .env and is never committed.
