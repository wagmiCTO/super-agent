# Secrets — never commit an API key, a seed or a wallet key
*.env
.env*
*.key
*.pem

# Build output
bin/
dist/
out/
cache/

# Editors
.idea/
.vscode/
.DS_Store

# JavaScript
node_modules/
.expo/

# Go
*.test
coverage.out

# Templates are committed; real values never are
!*.env.example
!.env.example

# Design canvases are build output: each bundles an editor runtime around the
# sources next to it and weighs ~3 MB. The sources are what is kept.
design/path/first-visit.html
design/style/two-skins.html
design/style/app-style-directions.html
design/brand/tradeagent-marks.html
apps/mobile/assets/judges/.orig/
