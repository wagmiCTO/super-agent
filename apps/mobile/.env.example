# Copy to .env. Expo inlines EXPO_PUBLIC_* at build time.

# Where the platform runs. On a physical phone use the laptop's LAN address and
# start the platform with PLATFORM_ADDR=0.0.0.0:8080.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Relying-party domain for passkeys on a device. Unset for the web build, where
# the page's own host is the relying party. See well-known/README.md.
EXPO_PUBLIC_RP_ID=inflight.work

# Where the web build and the chart page are served from, as seen from a phone.
# Defaults to the API host on port 8081 (Metro). Production: https://inflight.work
# EXPO_PUBLIC_WEB_URL=http://192.168.1.125:8081
