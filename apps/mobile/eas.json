{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://inflight.work",
        "EXPO_PUBLIC_WEB_URL": "https://inflight.work",
        "EXPO_PUBLIC_RP_ID": "inflight.work"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": { "appleTeamId": "9Q73U33Y7D", "ascAppId": "6814427558" }
    }
  }
}
